{
  "_README": "통합테스트 시스템별 설정. 각 팀원이 본인 시스템 블록 채움. prompt_file은 repo 상대경로. login 없으면 생략(공개 페이지). secret_domain은 sensitive_data 스코프.",

  "KORUS": {
    "url": "https://cnu.korus.ac.kr/",
    "prompt_file": "prompts/korus.txt",
    "allowed_domains": ["*.korus.ac.kr", "*.cnu.ac.kr"],
    "login": {
      "username_env": "KORUS_USERNAME",
      "password_env": "KORUS_PASSWORD",
      "username_key": "korus_username",
      "password_key": "korus_password",
      "secret_domain": "https://*.korus.ac.kr"
    }
  },

  "통합정보시스템": {
    "url": "https://cnuit.cnu.ac.kr/",
    "prompt_file": "prompts/cnuit.txt",
    "allowed_domains": ["*.cnu.ac.kr"],
    "login": {
      "username_env": "CNU_ID",
      "password_env": "CNU_PW",
      "username_key": "cnu_id",
      "password_key": "cnu_pw",
      "secret_domain": "https://*.cnu.ac.kr"
    },
    "_note": "박경서 담당. portal.cnu.ac.kr 로그인 → 통합정보시스템 새 탭(iframe). 프롬프트 prompts/cnuit.txt 채울 것."
  },

